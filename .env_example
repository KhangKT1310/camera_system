# ==============================================================================
# Camera System Framework - Environment Configuration Template
# Copy this file to .env and adjust paths for your local toolchain / sysroot.
# ==============================================================================

# ARM 32-bit Cross-Compiler Toolchain Settings
ARM_TOOLCHAIN_PATH=/path/to/arm32/toolchain/bin
ARM_COMPILER_PREFIX=arm-linux-

# ARM 64-bit Cross-Compiler Toolchain Settings (Optional)
# ARM64_TOOLCHAIN_PATH=/path/to/arm64/toolchain/bin
# ARM64_COMPILER_PREFIX=aarch64-linux-gnu-

# Target Board Sysroot Path
SYSROOT=/path/to/toolchain/sysroot

# Default CMake Build Output Directories
ARM_BUILD_DIR=build-arm32
ARM64_BUILD_DIR=build-arm64
